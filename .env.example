# CandyShop — copia este archivo a .env y ajusta los valores
PORT=3000

# URL de conexión de PostgreSQL
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/candyshop

# Secreto HMAC de firma de los access tokens JWT (¡ genera uno propio: openssl rand -hex 32 !)
JWT_SECRET=cambiame-por-64-caracteres-hexadecimales

# OAuth 2.0: vida de los tokens (segundos)
ACCESS_TOKEN_TTL=900          # access token JWT: 15 minutos
REFRESH_TOKEN_TTL=2592000     # refresh token: 30 días (rota en cada uso)

# Frontend React (Vite): 5173 en desarrollo / URL pública en producción.
# Se usa para CORS, redirects OAuth registrados y la vuelta de GitHub.
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGIN=*

# GitHub OAuth ("Entrar con GitHub") — crea una OAuth App en
# https://github.com/settings/developers y pega aquí el Client ID / Client Secret.
# Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback
