{
  "name": "candyshop-api",
  "version": "1.0.0",
  "description": "API REST + frontend para tienda de golosinas (estilo Fini Store)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "reset": "node src/seed.js --reset",
    "migrate": "node scripts/migrate-sqlite.mjs",
    "test": "node scripts/check-inline.js && node scripts/test-oauth.mjs && node scripts/test-shop.mjs",
    "test:oauth": "node scripts/test-oauth.mjs",
    "test:shop": "node scripts/test-shop.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "dependencies": {
    "pg": "^8.23.1"
  }
}
